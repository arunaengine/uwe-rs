params {
    n = 5
    flag = false
    outdir = 'results'
}
params.is_int = params.n instanceof Integer
process {
    cpus = 1
    withLabel: 'big' {
        memory = { 2.GB * task.attempt }
    }
}
includeConfig 'conf/base.config'
profiles {
    a {
        params.r = 'a'
        process.cpus = 2
    }
    b {
        params.r = 'b'
        includeConfig 'conf/b.config'
    }
}
params.after = "${params.r}-after"
includeConfig params.flag ? 'conf/missing.config' : '/dev/null'
process {
    withName: 'FOO|BAR' {
        ext.args = { "--id ${meta.id}" }
        publishDir = [path: { "${params.outdir}/foo" }, mode: 'copy']
    }
}
manifest.contributors = [[name: 'A', roles: ['x', 'y']]]
env.GREETING = 'it\'s'
timeline.file = "${params.outdir}/t.html"
