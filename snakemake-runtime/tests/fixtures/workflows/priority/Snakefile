# A priority function that gives no number fails as in Snakemake 9.27 (its test_priority_invalid).
rule all:
    input: 'out.txt'

rule valid_priority:
    output: 'valid.txt'
    priority: lambda wildcards: 1
    shell: 'touch {output}'

rule bad_priority:
    input: 'valid.txt'
    output: 'out.txt'
    priority: lambda wildcards: "not_a_number"
    shell: 'touch {output}'
