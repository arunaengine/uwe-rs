params {
    input = 'samplesheet.csv'
    outdir = 'results'
    report = null
    assets_dir = "${projectDir}/assets"
    mode = 'move'
    threads = 2
    secret_flag = false
    tool = [level: 5, name: 'bwa']
    mixed = 7
    loose = 'free'
    ref = 'genome.fa'
}
validation {
    summary {
        beforeText = 'SUMMARY-BEFORE\n'
        afterText = '\nSUMMARY-AFTER'
        hideParams = ['tool.name']
        maskSubpaths = ['/home/[^/]+']
        mask = '<masked>'
    }
}
process.container = 'quay.io/biocontainers/fastqc:0.12.1'
