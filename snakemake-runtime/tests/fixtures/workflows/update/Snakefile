# An update() output that exists is a copy that the job changes, and a before_update() input
# needs no job: Snakemake 9.27 writes foo and bar into test.txt here, and foo into out.txt
# (its test_update_flag).
rule all:
    input:
        "out.txt",
        "test.txt",


rule b:
    input:
        before_update("test.txt"),
    output:
        "out.txt",
    shell:
        "cp {input} {output}"


rule a:
    input:
        "in.txt",
    output:
        update("test.txt"),
    shell:
        "echo bar >> test.txt"
