# Input functions get the group id `local`, as in a local run of Snakemake 9.27, which writes
# `local` into each file here (its test_groupid_expand).
rule all:
    input:
        expand("bar{i}.txt", i=range(3)),


rule grouplocal:
    output:
        "foo.{groupid}.txt",
    group:
        "foo"
    shell:
        "echo {wildcards.groupid} > {output}"


def get_input(wildcards, groupid):
    return f"foo.{groupid}.txt"


rule consumer:
    input:
        get_input,
    output:
        "bar{i}.txt",
    group:
        "foo"
    shell:
        "cp {input} {output}"
