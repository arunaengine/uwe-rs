{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wir document",
  "description": "The JSON form of a wir 0.1 document. It checks the shape and the name patterns; the wir verifier checks types, edges, producers, cycles and op fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["wir_version", "graphs", "entry"],
  "properties": {
    "wir_version": { "enum": ["0.1"] },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "types": { "type": "array", "items": { "$ref": "#/$defs/type_def" } },
    "graphs": { "type": "array", "items": { "$ref": "#/$defs/graph" } },
    "entry": { "$ref": "#/$defs/name" }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" },
    "count": { "type": "integer", "minimum": 0 },
    "names": { "type": "array", "items": { "$ref": "#/$defs/name" } },
    "language": { "enum": ["cwl", "nextflow", "snakemake", "argo", "wdl"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "location"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "language": { "$ref": "#/$defs/language" },
        "location": { "type": "string" },
        "version": { "type": "string" },
        "digest": { "type": "string" }
      }
    },
    "type_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": { "name": { "$ref": "#/$defs/name" }, "type": { "$ref": "#/$defs/type" } }
    },
    "type": {
      "oneOf": [
        { "enum": ["bool", "int", "float", "string", "directory", "dynamic"] },
        { "$ref": "#/$defs/file_type" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record"],
          "properties": { "record": { "type": "array", "items": { "$ref": "#/$defs/field" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["array"],
          "properties": {
            "array": {
              "type": "object",
              "additionalProperties": false,
              "required": ["items"],
              "properties": {
                "items": { "$ref": "#/$defs/type" },
                "nonempty": { "type": "boolean" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["map"],
          "properties": {
            "map": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value"],
              "properties": {
                "key": { "enum": ["string", "int", "bool"] },
                "value": { "$ref": "#/$defs/type" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["optional"],
          "properties": { "optional": { "$ref": "#/$defs/type" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["union"],
          "properties": { "union": { "type": "array", "items": { "$ref": "#/$defs/type" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enum"],
          "properties": { "enum": { "type": "array", "items": { "type": "string" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tuple"],
          "properties": { "tuple": { "type": "array", "items": { "$ref": "#/$defs/type" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["named"],
          "properties": { "named": { "$ref": "#/$defs/name" } }
        }
      ]
    },
    "file_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "type": "string" },
            "secondary_files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pattern"],
                "properties": {
                  "pattern": { "type": "string" },
                  "required": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": { "name": { "type": "string" }, "type": { "$ref": "#/$defs/type" } }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/type" },
        "flow": { "enum": ["value", "stream"] },
        "default": true
      }
    },
    "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "inputs": { "$ref": "#/$defs/ports" },
        "outputs": { "$ref": "#/$defs/ports" },
        "ops": { "type": "array", "items": { "$ref": "#/$defs/op" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "read": { "enum": ["all", "live"] }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": { "op": { "$ref": "#/$defs/path" }, "port": { "$ref": "#/$defs/name" } }
    },
    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "kind": { "$ref": "#/$defs/kind" },
        "inputs": { "$ref": "#/$defs/ports" },
        "outputs": { "$ref": "#/$defs/ports" },
        "after": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "attributes": { "$ref": "#/$defs/attributes" },
        "values": { "$ref": "#/$defs/value_rules" },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": { "source": { "$ref": "#/$defs/name" }, "at": { "type": "string" } }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "on"],
      "properties": {
        "op": { "$ref": "#/$defs/path" },
        "on": {
          "type": "array",
          "items": { "enum": ["succeeded", "failed", "errored", "skipped", "omitted"] }
        }
      }
    },
    "effect": {
      "oneOf": [
        { "enum": ["nondeterministic", "log", "read_files", "write_files"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["publish"],
          "properties": { "publish": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["external"],
          "properties": { "external": { "type": "string" } }
        }
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cache": { "enum": ["default", "never", "resume"] },
        "place": { "type": "string" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpus": { "$ref": "#/$defs/count" },
            "memory": { "$ref": "#/$defs/count" },
            "disk": { "$ref": "#/$defs/count" },
            "gpus": { "$ref": "#/$defs/count" }
          }
        },
        "retry": { "$ref": "#/$defs/count" },
        "time": { "$ref": "#/$defs/count" }
      }
    },
    "kind": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "task": { "$ref": "#/$defs/task" },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["graph"],
          "properties": { "graph": { "$ref": "#/$defs/name" } }
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "language"],
          "properties": {
            "source": { "$ref": "#/$defs/name" },
            "language": { "$ref": "#/$defs/language" },
            "entry": { "type": "string" },
            "profiles": { "type": "array", "items": { "type": "string" } },
            "configs": { "$ref": "#/$defs/names" }
          }
        },
        "expr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "code"],
          "properties": {
            "language": { "$ref": "#/$defs/expr_language" },
            "code": { "type": "string" },
            "library": { "$ref": "#/$defs/texts" },
            "scope": { "$ref": "#/$defs/scope" },
            "captures": { "$ref": "#/$defs/captures" }
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body", "over"],
          "properties": {
            "body": { "$ref": "#/$defs/name" },
            "over": { "$ref": "#/$defs/names" },
            "mode": { "enum": ["dot", "flat_cross", "nested_cross"] },
            "parallelism": { "$ref": "#/$defs/count" },
            "min_success": { "$ref": "#/$defs/count" }
          }
        },
        "emit": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "each": { "type": "boolean" } }
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body"],
          "properties": {
            "body": { "$ref": "#/$defs/callback" },
            "nulls": { "$ref": "#/$defs/null_rule" }
          }
        },
        "flat_map": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "body": { "$ref": "#/$defs/callback" } }
        },
        "collect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body": { "$ref": "#/$defs/callback" },
            "flat": { "type": "boolean" },
            "sort": { "$ref": "#/$defs/sort" }
          }
        },
        "to_list": { "$ref": "#/$defs/empty" },
        "reduce": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule"],
          "properties": {
            "rule": { "enum": ["count", "sum", "min", "max", "fold"] },
            "body": { "$ref": "#/$defs/callback" },
            "compare": { "$ref": "#/$defs/callback" },
            "seed": { "$ref": "#/$defs/literal" },
            "empty": { "$ref": "#/$defs/empty_rule" },
            "nulls": { "enum": ["keep", "keep_state"] }
          }
        },
        "first": { "$ref": "#/$defs/pick" },
        "last": { "$ref": "#/$defs/pick" },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body"],
          "properties": { "body": { "$ref": "#/$defs/callback" } }
        },
        "flatten": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "depth": { "enum": ["one", "all"] },
            "drop_null": { "type": "boolean" }
          }
        },
        "mix": { "$ref": "#/$defs/empty" },
        "concat": { "$ref": "#/$defs/empty" },
        "merge": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "rounds": { "type": "boolean" }, "body": { "$ref": "#/$defs/callback" } }
        },
        "zip": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "remainder": { "type": "boolean" } }
        },
        "cross": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": { "$ref": "#/$defs/callback" },
            "left": { "enum": ["first", "last", "error"] }
          }
        },
        "group": { "$ref": "#/$defs/group_tuple" },
        "group_tuple": { "$ref": "#/$defs/group_tuple" },
        "join": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "by": { "$ref": "#/$defs/positions" },
            "remainder": { "type": "boolean" },
            "mismatch_error": { "type": "boolean" },
            "duplicate_error": { "type": "boolean" },
            "body": { "$ref": "#/$defs/callback" }
          }
        },
        "combine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "by": { "$ref": "#/$defs/positions" },
            "body": { "$ref": "#/$defs/callback" }
          }
        },
        "buffer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule"],
          "properties": {
            "rule": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["size"],
                  "properties": {
                    "size": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["size"],
                      "properties": { "size": { "$ref": "#/$defs/count" }, "skip": { "$ref": "#/$defs/count" } }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["match"],
                  "properties": {
                    "match": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["close"],
                      "properties": {
                        "open": { "$ref": "#/$defs/callback" },
                        "close": { "$ref": "#/$defs/callback" }
                      }
                    }
                  }
                }
              ]
            },
            "remainder": { "type": "boolean" }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": { "$ref": "#/$defs/count" },
            "step": { "$ref": "#/$defs/count" },
            "remainder": { "type": "boolean" }
          }
        },
        "take": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": { "count": { "type": "integer" } }
        },
        "unique": { "$ref": "#/$defs/keyed" },
        "distinct": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "key": { "$ref": "#/$defs/callback" }, "initial": { "$ref": "#/$defs/literal" } }
        },
        "until": {
          "type": "object",
          "additionalProperties": false,
          "required": ["predicate"],
          "properties": { "predicate": { "$ref": "#/$defs/callback" }, "inclusive": { "type": "boolean" } }
        },
        "if_empty": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "value": { "$ref": "#/$defs/literal" }, "body": { "$ref": "#/$defs/callback" } }
        },
        "split": { "$ref": "#/$defs/split" },
        "collect_file": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body": { "$ref": "#/$defs/callback" },
            "name": { "type": "string" },
            "directory": { "type": "string" },
            "sort": { "$ref": "#/$defs/sort" },
            "new_line": { "type": "boolean" },
            "skip": { "$ref": "#/$defs/count" },
            "keep_header": { "type": "boolean" },
            "seed": { "type": "string" }
          }
        },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "body": { "$ref": "#/$defs/callback" }, "new_line": { "type": "boolean" } }
        },
        "observe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "item": { "$ref": "#/$defs/closure" },
            "close": { "$ref": "#/$defs/closure" },
            "error": { "$ref": "#/$defs/closure" }
          }
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cases"],
          "properties": {
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["output", "condition"],
                "properties": {
                  "output": { "$ref": "#/$defs/name" },
                  "condition": { "$ref": "#/$defs/callback" },
                  "body": { "$ref": "#/$defs/callback" }
                }
              }
            }
          }
        },
        "multi_map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outputs"],
          "properties": {
            "outputs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["output", "body"],
                "properties": {
                  "output": { "$ref": "#/$defs/name" },
                  "body": { "$ref": "#/$defs/callback" },
                  "nulls": { "$ref": "#/$defs/null_rule" }
                }
              }
            }
          }
        },
        "branch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body", "condition"],
          "properties": {
            "body": { "$ref": "#/$defs/name" },
            "condition": { "$ref": "#/$defs/name" }
          }
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule"],
          "properties": { "rule": { "enum": ["first", "only", "all"] } }
        },
        "loop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body", "condition"],
          "properties": {
            "body": { "$ref": "#/$defs/name" },
            "condition": { "$ref": "#/$defs/name" },
            "carry": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["output", "input"],
                "properties": {
                  "output": { "$ref": "#/$defs/name" },
                  "input": { "$ref": "#/$defs/name" }
                }
              }
            }
          }
        },
        "dynamic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan"],
          "properties": { "plan": { "$ref": "#/$defs/name" } }
        }
      }
    },
    "empty": { "type": "object", "additionalProperties": false },
    "texts": { "type": "array", "items": { "type": "string" } },
    "null_rule": { "enum": ["drop", "keep"] },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": { "value": true }
    },
    "empty_rule": {
      "oneOf": [{ "enum": ["default", "close", "null", "error"] }, { "$ref": "#/$defs/literal" }]
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "keep_header": { "type": "boolean" } }
            },
            "csv": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "separator": { "$ref": "#/$defs/character" },
                "quote": { "oneOf": [{ "$ref": "#/$defs/character" }, { "type": "null" }] },
                "header": {
                  "oneOf": [
                    { "enum": ["none", "read"] },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["names"],
                      "properties": { "names": { "$ref": "#/$defs/texts" } }
                    }
                  ]
                },
                "skip": { "$ref": "#/$defs/count" },
                "strip": { "type": "boolean" }
              }
            },
            "fasta": { "$ref": "#/$defs/sequence_split" },
            "fastq": { "$ref": "#/$defs/sequence_split" },
            "json": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "path": { "type": "string" } }
            }
          }
        },
        "size": { "$ref": "#/$defs/count" },
        "limit": { "$ref": "#/$defs/count" },
        "elem": { "$ref": "#/$defs/count" },
        "pair": {
          "oneOf": [
            { "const": "auto" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["at"],
              "properties": {
                "at": { "type": "array", "items": { "$ref": "#/$defs/count" }, "minItems": 2, "maxItems": 2 }
              }
            }
          ]
        },
        "decompress": { "enum": ["auto", "always", "never"] },
        "charset": { "type": "string" },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "directory": { "type": "string" },
            "compress": { "type": "boolean" }
          }
        },
        "body": { "$ref": "#/$defs/callback" }
      }
    },
    "character": { "type": "string", "minLength": 1, "maxLength": 1 },
    "sequence_split": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "field"],
            "properties": {
              "name": { "type": "string" },
              "field": {
                "enum": ["id", "header", "desc", "text", "sequence", "seq_string", "read_header",
                  "read_string", "quality_header", "quality_string"]
              }
            }
          }
        }
      }
    },
    "keyed": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "key": { "$ref": "#/$defs/callback" } }
    },
    "pick": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "predicate": { "$ref": "#/$defs/callback" },
        "empty": { "$ref": "#/$defs/empty_rule" }
      }
    },
    "positions": { "type": "array", "items": { "$ref": "#/$defs/count" } },
    "sort": {
      "oneOf": [
        { "enum": ["none", "natural", "index", "hash", "deep"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": { "key": { "$ref": "#/$defs/callback" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["compare"],
          "properties": { "compare": { "$ref": "#/$defs/callback" } }
        }
      ]
    },
    "group_tuple": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": { "$ref": "#/$defs/positions" },
        "size": { "$ref": "#/$defs/count" },
        "size_body": { "$ref": "#/$defs/callback" },
        "remainder": { "type": "boolean" },
        "sort": { "$ref": "#/$defs/sort" }
      }
    },
    "expr_language": { "enum": ["js", "javascript", "groovy", "python", "wdl"] },
    "value_rules": { "enum": ["wir", "groovy", "python", "wdl", "javascript"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "start", "end"],
      "properties": {
        "source": { "$ref": "#/$defs/name" },
        "start": { "$ref": "#/$defs/count" },
        "end": { "$ref": "#/$defs/count" }
      }
    },
    "captures": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["input"],
            "properties": { "input": { "$ref": "#/$defs/name" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": { "value": true }
          }
        ]
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "code"],
      "properties": {
        "language": { "$ref": "#/$defs/expr_language" },
        "code": { "type": "string" },
        "parameters": { "$ref": "#/$defs/texts" },
        "library": { "$ref": "#/$defs/texts" },
        "scope": { "$ref": "#/$defs/scope" },
        "captures": { "$ref": "#/$defs/captures" }
      }
    },
    "callback": { "oneOf": [{ "$ref": "#/$defs/name" }, { "$ref": "#/$defs/closure" }] },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "image": { "type": "string" },
        "command": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["input"],
                "properties": { "input": { "$ref": "#/$defs/name" } }
              }
            ]
          }
        },
        "captures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["output", "from"],
            "properties": {
              "output": { "$ref": "#/$defs/name" },
              "from": {
                "oneOf": [
                  { "enum": ["stdout", "stderr"] },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["glob"],
                    "properties": { "glob": { "type": "string" } }
                  }
                ]
              }
            }
          }
        },
        "success_codes": { "type": "array", "items": { "type": "integer" } },
        "network": { "type": "boolean" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      }
    }
  }
}
