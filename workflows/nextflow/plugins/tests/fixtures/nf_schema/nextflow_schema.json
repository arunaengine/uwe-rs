{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/probe/nextflow_schema.json",
  "title": "probe pipeline parameters",
  "description": "Probe schema",
  "type": "object",
  "$defs": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "fa_icon": "fas fa-terminal",
      "description": "Define where the pipeline should find input data and save output data.",
      "required": ["input", "outdir"],
      "properties": {
        "input": {
          "type": "string",
          "format": "file-path",
          "exists": true,
          "schema": "assets/schema_input.json",
          "mimetype": "text/csv",
          "pattern": "^\\S+\\.csv$",
          "description": "Path to comma-separated file containing information about the samples.",
          "fa_icon": "fas fa-file-csv"
        },
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "description": "The output directory where the results will be saved.",
          "fa_icon": "fas fa-folder-open"
        },
        "report": {
          "type": "string",
          "default": "${params.outdir}/report.html",
          "description": "Report file."
        },
        "assets_dir": {
          "type": "string",
          "default": "${projectDir}/assets",
          "description": "Assets folder."
        }
      }
    },
    "generic_options": {
      "title": "Generic options",
      "type": "object",
      "description": "Less common options.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
          "default": "copy",
          "description": "Method used to save pipeline results to output directory."
        },
        "threads": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "description": "Number of threads."
        },
        "secret_flag": {
          "type": "boolean",
          "hidden": true,
          "description": "A hidden flag."
        },
        "tool": {
          "type": "object",
          "description": "Tool settings.",
          "properties": {
            "level": {"type": "integer", "default": 3, "description": "Tool level."},
            "name": {"type": "string", "description": "Tool name."}
          }
        },
        "mixed": {
          "type": ["string", "integer"],
          "description": "A value of two types."
        }
      }
    }
  },
  "allOf": [
    {"$ref": "#/$defs/input_output_options"},
    {"$ref": "#/$defs/generic_options"}
  ],
  "properties": {
    "loose": {"type": "string", "description": "An ungrouped parameter."}
  }
}
