plugins { id 'nf-bactopia@2.1.7' }
manifest {
    name = 'bactopia/bactopia'
    version = '9.9.9'
    description = 'Probe pipeline'
}
bactopia.monochromeLogs = true
params {
    sample = null
    r1 = null
    r2 = null
    se = null
    ont = null
    assembly = null
    samples = null
    accession = null
    accessions = null
    genome_size = 0
    species = 'UNKNOWN_SPECIES'
    max_downloads = 3
    outdir = 'bactopia'
    help = false
    help_all = false
    workflow = [name: 'bactopia', description: 'Probe workflow', ext: ['fastq']]
}
