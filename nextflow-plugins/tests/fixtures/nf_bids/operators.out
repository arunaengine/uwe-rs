groupTupleBy composite => [[CompositeKey([sub-01, true]), [[subject:sub-01, run:2, f:a], [subject:sub-01, run:3, f:d]]], [CompositeKey([sub-02, false]), [[subject:sub-02, run:1, f:c]]], [CompositeKey([sub-01, false]), [[subject:sub-01, run:1, f:b]]]]
