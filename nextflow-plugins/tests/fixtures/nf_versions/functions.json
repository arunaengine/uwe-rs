{
    "bambyVersion": "\n    echo 'bamby: \"'$( bamby --version | sed -e 's/bamby //g' )'\"'\n",
    "bcftoolsVersion": "\n    echo 'bcftools: \"'$( bcftools --version | head -n1 | sed -e 's/bcftools //g' )'\"'\n",
    "bedtoolsVersion": "\n    echo 'bedtools: \"'$( bedtools --version | sed -e 's/bedtools v//g' )'\"'\n",
    "bwaVersion": "\n    echo 'bwa: \"'$( bwa 2>&1 | sed -n 's/^Version: //p' )'\"'\n",
    "bwaMem2Version": "\n    echo 'bwa-mem2: \"'$( bwa-mem2 version )'\"'\n",
    "bwaMem3Version": "\n    echo 'bwa-mem3: \"'$( bwa-mem3 version | head -n1 )'\"'\n",
    "chelaeVersion": "\n    echo 'chelae: \"'$( chelae --version | sed -e 's/chelae //g' )'\"'\n",
    "dupblasterVersion": "\n    echo 'dupblaster: \"'$( dupblaster --version | sed -e 's/dupblaster //g' )'\"'\n",
    "ensemblVepVersion": "\n    echo 'ensembl-vep: \"'$( vep --help | sed -n 's/^ *ensembl-vep *: *//p' )'\"'\n",
    "falcoVersion": "\n    echo 'falco: \"'$( falco --version | sed -e 's/falco //g' )'\"'\n",
    "fastpVersion": "\n    echo 'fastp: \"'$( fastp --version 2>&1 | sed -e 's/fastp //g' )'\"'\n",
    "fastqcVersion": "\n    echo 'fastqc: \"'$( fastqc --version | sed -e 's/FastQC v//g' )'\"'\n",
    "fastqcRsVersion": "\n    echo 'fastqc-rs: \"'$( fqc --version 2>&1 | sed -e 's/fastqc-rs //g' )'\"'\n",
    "fgbioVersion": "\n    echo 'fgbio: \"'$(\n        fgbio --version 2>&1             | tr -d '[:cntrl:]'             | sed -e 's/^.*Version: //' -e 's/\\[.*$//'\n    )'\"'\n",
    "fgumiVersion": "\n    echo 'fgumi: \"'$( fgumi --version | sed -e 's/fgumi //g' )'\"'\n",
    "mosdepthVersion": "\n    echo 'mosdepth: \"'$( mosdepth --version | sed -e 's/mosdepth //g' )'\"'\n",
    "picardVersion": "\n    echo 'picard: \"'$( picard ViewSam --version true 2>&1 | grep -v 'cannot change locale' | sed -e 's/Version://g' )'\"'\n",
    "revtagVersion": "\n    echo 'revtag: \"'$( revtag --version | sed -e 's/revtag //g' )'\"'\n",
    "rikerVersion": "\n    echo 'riker: \"'$( riker --version | sed -e 's/riker //g' )'\"'\n",
    "sambambaVersion": "\n    echo 'sambamba: \"'$( sambamba --version 2>&1 | sed -n 's/^sambamba //p' | head -n1 )'\"'\n",
    "samtoolsVersion": "\n    echo 'samtools: \"'$( samtools --version | head -n1 | sed -e 's/samtools //g' )'\"'\n",
    "snpeffVersion": "\n    echo 'snpeff: \"'$( snpEff -version | head -n1 | cut -f2 )'\"'\n",
    "snpsiftVersion": "\n    echo 'snpsift: \"'$( SnpSift 2>&1 | sed -n 's/^SnpSift version \\([^ ]*\\).*/\\1/p' )'\"'\n",
    "somalierVersion": "\n    echo 'somalier: \"'$( somalier 2>&1 | sed -n 's/^somalier version: //p' )'\"'\n",
    "splitcodeVersion": "\n    echo 'splitcode: \"'$( splitcode --version | sed -e 's/splitcode, version //g' | sed 's/\\.$//' )'\"'\n",
    "unmuxVersion": "\n    echo 'unmux: \"'$( unmux --version | sed -e 's/unmux //g' )'\"'\n",
    "vartovcfVersion": "\n    echo 'vartovcf: \"'$( vartovcf --version | sed -e 's/vartovcf //g' )'\"'\n",
    "vcfannoVersion": "\n    echo 'vcfanno: \"'$( vcfanno 2>&1 | sed -n 's/^vcfanno version \\([^ ]*\\).*/\\1/p' )'\"'\n",
    "pyPackageVersion(cutadapt)": "\necho 'cutadapt: \"'$( python3 -c 'import sys; from importlib.metadata import version; print(version(sys.argv[1]))' cutadapt 2>/dev/null )'\"'\n",
    "rLibraryVersion(ichorCNA)": "\necho 'ichorCNA: \"'$( Rscript -e 'cat(as.character(packageVersion(commandArgs(trailingOnly=TRUE)[1])))' ichorCNA 2>/dev/null )'\"'\n"
}
